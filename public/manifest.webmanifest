{
  "id": "./",
  "name": "Tsrukpe-Tota WATSAN Customer Portal",
  "short_name": "WATSAN Portal",
  "description": "Manage your Tsrukpe-Tota WATSAN water account, bills and payments.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f8fb",
  "theme_color": "#0d3f87",
  "icons": [
    {
      "src": "./pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./pwa-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}